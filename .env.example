# Firebase Configuration
# Copy this file to `.env` and fill in your Firebase project values.
# If .env is present, it takes priority over firebase-applet-config.json.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Server Configuration
PORT=3000

# SMTP Configuration (for email sending in server.ts)
# If these are empty, the server falls back to an Ethereal test mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@pharmaflow.com