{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "staff"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product/medication",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "category": { "type": "string" },
        "brand": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "stockQuantity": { "type": "number" },
        "minimumStock": { "type": "number" },
        "expiryDate": { "type": "string" },
        "userId": { "type": "string" },
        "batches": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "sku", "sellingPrice", "stockQuantity", "userId"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Product suppliers",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "gstNumber": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" },
        "tenantId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "tenantId"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Stock Purchase",
      "type": "object",
      "properties": {
        "purchaseNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "invoiceDate": { "type": "string" },
        "totalAmount": { "type": "number" },
        "itemsCount": { "type": "number" },
        "notes": { "type": "string" },
        "tenantId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["purchaseNumber", "supplierId", "invoiceNumber", "tenantId"]
    },
    "PurchaseItem": {
      "title": "PurchaseItem",
      "description": "Item in a stock purchase",
      "type": "object",
      "properties": {
        "purchaseId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "batchNumber": { "type": "string" },
        "mfgDate": { "type": "string" },
        "expiryDate": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "quantity": { "type": "number" },
        "mrp": { "type": "number" },
        "gstPercentage": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" }
      },
      "required": ["purchaseId", "productId", "batchNumber", "quantity"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Product stock ledger",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "batchNumber": { "type": "string" },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "purchaseId": { "type": "string" },
        "invoiceId": { "type": "string" },
        "tenantId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "productId", "batchNumber", "quantity", "tenantId"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "outstandingBalance": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "totalPaid": { "type": "number" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "userId"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Sales invoice",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "grandTotal": { "type": "number" },
        "amountPaid": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["invoiceNumber", "items", "grandTotal", "userId"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Store settings",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "currency": { "type": "string" },
        "taxRate": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["storeName", "userId"]
    },
    "Brand": {
      "title": "Brand",
      "description": "Product brand reference",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tenantId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "tenantId"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Inventory collection"
    },
    "/brands/{brandId}": {
      "schema": "Brand",
      "description": "Brands reference collection"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer collection"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoice collection"
    },
    "/settings/{userId}": {
      "schema": "Settings",
      "description": "User specific settings"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Supplier collection"
    },
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Purchases collection"
    },
    "/purchaseItems/{itemId}": {
      "schema": "PurchaseItem",
      "description": "Purchase items collection"
    },
    "/stockMovements/{movementId}": {
      "schema": "StockMovement",
      "description": "Stock ledger movements"
    }
  }
}
