rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user is a member of the tenant via subcollection
    function isMemberOfTenant(tenantId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid));
    }

    // Get role from tenant subcollection (source of truth for membership)
    function getMemberRole(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.role;
    }

    // Legacy helper retained for top-level users doc checks
    function isTenantUser(tenantId) {
      return isAuthenticated() && getUserData().tenantId == tenantId;
    }

    function getRole(tenantId) {
      return getUserData().role;
    }

    // User profiles (top-level)
    match /users/{userId} {
      allow get: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && request.auth.uid == userId;
    }

    // Tenants
    match /tenants/{tenantId} {
      allow get: if isTenantUser(tenantId) || isMemberOfTenant(tenantId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isTenantUser(tenantId) || isMemberOfTenant(tenantId)) && (getRole(tenantId) == 'owner' || getMemberRole(tenantId) == 'owner');
      
      // Tenant member subcollection
      match /users/{userId} {
        allow read: if isMemberOfTenant(tenantId);
        allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'owner';
        allow write: if isMemberOfTenant(tenantId) && getMemberRole(tenantId) == 'owner';
      }

      match /logs/{logId} {
        allow read: if isMemberOfTenant(tenantId) && getMemberRole(tenantId) in ['owner', 'admin'];
        allow create: if isMemberOfTenant(tenantId);
      }
    }

    // Products
    match /products/{productId} {
      allow read: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId);
      allow create: if isAuthenticated() && isMemberOfTenant(request.resource.data.tenantId) && getMemberRole(request.resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow update: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow delete: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin'];
    }

    // Brands
    match /brands/{brandId} {
      allow read: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId);
      allow create: if isAuthenticated() && isMemberOfTenant(request.resource.data.tenantId) && getMemberRole(request.resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow update: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow delete: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin'];
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId);
      allow write: if isAuthenticated() && isMemberOfTenant(request.resource.data.tenantId || resource.data.tenantId) && getMemberRole(request.resource.data.tenantId || resource.data.tenantId) in ['owner', 'admin', 'staff'];
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId);
      allow create: if isAuthenticated() && isMemberOfTenant(request.resource.data.tenantId) && getMemberRole(request.resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow update: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow delete: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin'];
    }

    // Counters (tenant-scoped by counterId pattern: invoices_{tenantId})
    match /counters/{counterId} {
      // Extract tenantId from counterId like "invoices_tenant_abc123"
      allow read: if isAuthenticated() && isMemberOfTenant(counterId.split('_').slice(1).join('_'));
      allow write: if isAuthenticated() && isMemberOfTenant(counterId.split('_').slice(1).join('_'));
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId);
      allow create: if isAuthenticated() && isMemberOfTenant(request.resource.data.tenantId) && getMemberRole(request.resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow update: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow delete: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin'];
    }

    // Purchases
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId);
      allow create: if isAuthenticated() && isMemberOfTenant(request.resource.data.tenantId) && getMemberRole(request.resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow update: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow delete: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin'];
    }

    // Purchase Items (tenant-scoped)
    match /purchaseItems/{itemId} {
      allow read: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId);
      allow create: if isAuthenticated() && isMemberOfTenant(request.resource.data.tenantId) && getMemberRole(request.resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow update: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow delete: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin'];
    }

    // Stock Movements
    match /stockMovements/{movementId} {
      allow read: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId);
      allow create: if isAuthenticated() && isMemberOfTenant(request.resource.data.tenantId) && getMemberRole(request.resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow update: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow delete: if isAuthenticated() && isMemberOfTenant(resource.data.tenantId) && getMemberRole(resource.data.tenantId) in ['owner', 'admin'];
    }

    // Settings (Scoped by tenantId)
    match /settings/{tenantId} {
      allow read: if isMemberOfTenant(tenantId);
      allow write: if isMemberOfTenant(tenantId) && getMemberRole(tenantId) in ['owner', 'admin'];
    }
  }
}