rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTenantUser(tenantId) {
      return isAuthenticated() && getUserData().tenantId == tenantId;
    }

    function getRole(tenantId) {
      return getUserData().role;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && request.auth.uid == userId;
    }

    // Tenants
    match /tenants/{tenantId} {
      allow get: if isTenantUser(tenantId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isTenantUser(tenantId) && getRole(tenantId) == 'owner';
      
      match /users/{userId} {
        allow read: if isTenantUser(tenantId);
        allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'owner';
        allow write: if isTenantUser(tenantId) && getRole(tenantId) == 'owner';
      }

      match /logs/{logId} {
        allow read: if isTenantUser(tenantId) && getRole(tenantId) in ['owner', 'admin'];
        allow create: if isTenantUser(tenantId);
      }
    }

    // Products
    match /products/{productId} {
      allow read: if isAuthenticated() && isTenantUser(resource.data.tenantId);
      allow create: if isAuthenticated() && isTenantUser(request.resource.data.tenantId) && getRole(request.resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow update: if isAuthenticated() && isTenantUser(resource.data.tenantId) && getRole(resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow delete: if isAuthenticated() && isTenantUser(resource.data.tenantId) && getRole(resource.data.tenantId) in ['owner', 'admin'];
    }

    // Brands
    match /brands/{brandId} {
      allow read: if isAuthenticated() && isTenantUser(resource.data.tenantId);
      allow create: if isAuthenticated() && isTenantUser(request.resource.data.tenantId) && getRole(request.resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow update: if isAuthenticated() && isTenantUser(resource.data.tenantId) && getRole(resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow delete: if isAuthenticated() && isTenantUser(resource.data.tenantId) && getRole(resource.data.tenantId) in ['owner', 'admin'];
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isAuthenticated() && isTenantUser(resource.data.tenantId);
      allow write: if isAuthenticated() && isTenantUser(request.resource.data.tenantId || resource.data.tenantId) && getRole(request.resource.data.tenantId || resource.data.tenantId) in ['owner', 'admin', 'staff'];
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && isTenantUser(resource.data.tenantId);
      allow create: if isAuthenticated() && isTenantUser(request.resource.data.tenantId) && getRole(request.resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow update: if isAuthenticated() && isTenantUser(resource.data.tenantId) && getRole(resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow delete: if isAuthenticated() && isTenantUser(resource.data.tenantId) && getRole(resource.data.tenantId) in ['owner', 'admin'];
    }

    // Counters
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated() && isTenantUser(resource.data.tenantId);
      allow create: if isAuthenticated() && isTenantUser(request.resource.data.tenantId) && getRole(request.resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow update: if isAuthenticated() && isTenantUser(resource.data.tenantId) && getRole(resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow delete: if isAuthenticated() && isTenantUser(resource.data.tenantId) && getRole(resource.data.tenantId) in ['owner', 'admin'];
    }

    // Purchases
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && isTenantUser(resource.data.tenantId);
      allow create: if isAuthenticated() && isTenantUser(request.resource.data.tenantId) && getRole(request.resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow update: if isAuthenticated() && isTenantUser(resource.data.tenantId) && getRole(resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow delete: if isAuthenticated() && isTenantUser(resource.data.tenantId) && getRole(resource.data.tenantId) in ['owner', 'admin'];
    }

    // Purchase Items
    match /purchaseItems/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // Stock Movements
    match /stockMovements/{movementId} {
      allow read: if isAuthenticated() && isTenantUser(resource.data.tenantId);
      allow create: if isAuthenticated() && isTenantUser(request.resource.data.tenantId) && getRole(request.resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow update: if isAuthenticated() && isTenantUser(resource.data.tenantId) && getRole(resource.data.tenantId) in ['owner', 'admin', 'staff'];
      allow delete: if isAuthenticated() && isTenantUser(resource.data.tenantId) && getRole(resource.data.tenantId) in ['owner', 'admin'];
    }

    // Settings (Scoped by tenantId)
    match /settings/{tenantId} {
      allow read: if isTenantUser(tenantId);
      allow write: if isTenantUser(tenantId) && getRole(tenantId) in ['owner', 'admin'];
    }
  }
}
