rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasUser() { return signedIn() && exists(userPath()); }
    function userData() { return get(userPath()).data; }
    function inTenant(tenantId) {
      return hasUser() && userData().status == 'active' && userData().tenantId == tenantId;
    }
    function roleIs(roles) { return hasUser() && userData().role in roles; }
    function hasTenantPrefixedId(documentId) {
      return hasUser()
        && userData().status == 'active'
        && documentId.matches('^' + userData().tenantId + '_.*');
    }
    function isOwnCounter(counterId) {
      return hasUser()
        && userData().status == 'active'
        && (
          counterId == 'invoices_' + userData().tenantId
          || counterId == 'estimates_' + userData().tenantId
          || counterId == userData().tenantId + '_purchase'
        );
    }
    function ownsInvoice(invoiceId) {
      return hasUser()
        && userData().status == 'active'
        && exists(/databases/$(database)/documents/invoices/$(invoiceId))
        && get(/databases/$(database)/documents/invoices/$(invoiceId)).data.tenantId
          == userData().tenantId;
    }
    function ownsPurchase(purchaseId) {
      return hasUser()
        && userData().status == 'active'
        && exists(/databases/$(database)/documents/purchases/$(purchaseId))
        && get(/databases/$(database)/documents/purchases/$(purchaseId)).data.tenantId
          == userData().tenantId;
    }
    function signedInEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }
    function validTenantCreate(tenantId) {
      return inTenant(tenantId) && request.resource.data.tenantId == tenantId;
    }
    function sameTenant() {
      return request.resource.data.tenantId == resource.data.tenantId;
    }
    function validInvoice() {
      return request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.subtotal is number && request.resource.data.subtotal >= 0
        && request.resource.data.gstTotal is number && request.resource.data.gstTotal >= 0
        && request.resource.data.discount is number && request.resource.data.discount >= 0
        && request.resource.data.grandTotal is number && request.resource.data.grandTotal >= 0
        && request.resource.data.amountReceived is number && request.resource.data.amountReceived >= 0
        && request.resource.data.outstandingAmount is number && request.resource.data.outstandingAmount >= 0
        && request.resource.data.amountReceived <= request.resource.data.grandTotal
        && request.resource.data.outstandingAmount <= request.resource.data.grandTotal
        && request.resource.data.paymentStatus in ['paid','due','partial']
        && (
          !('saleMode' in request.resource.data)
          || request.resource.data.saleMode in ['retail','wholesale']
        );
    }
    function validEstimate() {
      return request.resource.data.documentType == 'estimate'
        && request.resource.data.taxInvoice == false
        && request.resource.data.gstTotal == 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.subtotal is number
        && request.resource.data.discount is number
        && request.resource.data.grandTotal is number
        && request.resource.data.grandTotal >= 0
        && request.resource.data.status in ['draft','sent','accepted','expired','converted','cancelled'];
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && (
          (
            request.resource.data.role == 'owner'
            && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId))
            && get(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.ownerId == request.auth.uid
          )
          ||
          (
            request.resource.data.invitationId is string
            && exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId))
            && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == 'pending'
            && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.email == signedInEmail()
            && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.tenantId == request.resource.data.tenantId
            && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.role == request.resource.data.role
          )
        );
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'lastLogin']);
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow get: if inTenant(tenantId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == tenantId;
      allow update: if inTenant(tenantId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == resource.data.id
        && (
          (
            roleIs(['owner','admin'])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name','usage','updatedAt'])
          )
          ||
          (
            roleIs(['owner'])
            && request.resource.data.businessMode in ['retail','wholesale','hybrid']
            && request.resource.data.businessModeConfigured == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['businessMode','businessModeConfigured','updatedAt'])
          )
          ||
          (
            roleIs(['owner'])
            && resource.data.plan == 'free'
            && !('trialStartedAt' in resource.data)
            && request.resource.data.plan == 'pro'
            && request.resource.data.subscriptionStatus == 'trialing'
            && request.resource.data.limits.maxInvoices == 1000
            && request.resource.data.limits.maxProducts == 5000
            && request.resource.data.limits.maxUsers == 5
            && request.resource.data.trialStartedAt == request.time
            && request.resource.data.trialEndsAt > request.time
            && request.resource.data.trialEndsAt <= request.time + duration.value(31, 'd')
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'plan','limits','subscriptionStatus','trialStartedAt',
                'trialEndsAt','updatedAt'
              ])
          )
          ||
          (
            roleIs(['owner'])
            && request.resource.data.plan == 'free'
            && request.resource.data.subscriptionStatus == 'cancelled'
            && request.resource.data.limits.maxInvoices == 50
            && request.resource.data.limits.maxProducts == 100
            && request.resource.data.limits.maxUsers == 1
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['plan','limits','subscriptionStatus','updatedAt'])
          )
          ||
          (
            roleIs(['staff'])
            && !('usage' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['usage','updatedAt'])
            && request.resource.data.usage.productsCount is int
            && request.resource.data.usage.productsCount > 0
            && request.resource.data.usage.productsCount <= 50
            && request.resource.data.usage.invoicesCount == 0
            && request.resource.data.usage.usersCount == 1
          )
          ||
          (
            roleIs(['staff'])
            && ('usage' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['usage','updatedAt'])
            && request.resource.data.usage.productsCount
              > resource.data.usage.productsCount
            && request.resource.data.usage.productsCount
              <= resource.data.usage.productsCount + 50
            && request.resource.data.usage.invoicesCount
              == resource.data.usage.invoicesCount
            && request.resource.data.usage.usersCount
              == resource.data.usage.usersCount
          )
        );
      allow delete: if false;

      match /users/{userId} {
        allow read: if inTenant(tenantId);
        allow create: if signedIn() && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.tenantId == tenantId
          && (
            (
              request.resource.data.role == 'owner'
              && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid
            )
            ||
            (
              request.resource.data.invitationId is string
              && exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId))
              && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == 'pending'
              && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.email == signedInEmail()
              && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.tenantId == tenantId
              && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.role == request.resource.data.role
            )
          );
        allow update, delete: if inTenant(tenantId) && roleIs(['owner']);
      }

      match /logs/{logId} {
        allow read: if inTenant(tenantId) && roleIs(['owner', 'admin']);
        allow create: if inTenant(tenantId)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }

      match /usageCounters/{month} {
        allow read: if inTenant(tenantId);
        allow create: if inTenant(tenantId)
          && roleIs(['owner','admin','staff'])
          && request.resource.data.tenantId == tenantId
          && request.resource.data.month == month
          && request.resource.data.invoicesCount == 1;
        allow update: if inTenant(tenantId)
          && roleIs(['owner','admin','staff'])
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.month == resource.data.month
          && request.resource.data.invoicesCount is int
          && request.resource.data.invoicesCount >= 0
          && (
            request.resource.data.invoicesCount == resource.data.invoicesCount + 1
            || request.resource.data.invoicesCount == resource.data.invoicesCount - 1
          )
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['invoicesCount','updatedAt']);
        allow delete: if false;
      }
    }

    match /invitations/{invitationId} {
      allow read: if (
        inTenant(resource.data.tenantId) && roleIs(['owner','admin'])
      ) || (
        signedIn()
        && resource.data.status == 'pending'
        && resource.data.email == signedInEmail()
      );
      allow create: if validTenantCreate(request.resource.data.tenantId)
        && roleIs(['owner','admin'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.role in ['admin','staff','viewer']
        && request.resource.data.status == 'pending';
      allow update: if (
        inTenant(resource.data.tenantId)
        && roleIs(['owner','admin'])
        && request.resource.data.tenantId == resource.data.tenantId
      ) || (
        signedIn()
        && resource.data.status == 'pending'
        && resource.data.email == signedInEmail()
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','acceptedBy','acceptedAt'])
      );
      allow delete: if inTenant(resource.data.tenantId) && roleIs(['owner','admin']);
    }

    match /subscriptionRequests/{requestId} {
      allow read: if inTenant(resource.data.tenantId) && roleIs(['owner']);
      allow create: if validTenantCreate(request.resource.data.tenantId)
        && roleIs(['owner'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.requestedPlan in ['pro','business']
        && request.resource.data.billingPeriod in ['monthly','annually']
        && request.resource.data.amount is number
        && (
          (
            request.resource.data.requestedPlan == 'pro'
            && (
              (request.resource.data.billingPeriod == 'monthly' && request.resource.data.amount == 199)
              || (request.resource.data.billingPeriod == 'annually' && request.resource.data.amount == 1990)
            )
          )
          ||
          (
            request.resource.data.requestedPlan == 'business'
            && (
              (request.resource.data.billingPeriod == 'monthly' && request.resource.data.amount == 399)
              || (request.resource.data.billingPeriod == 'annually' && request.resource.data.amount == 3990)
            )
          )
        )
        && request.resource.data.currency == 'INR'
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    match /products/{productId} {
      allow read: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId) && roleIs(['owner','admin','staff']);
      allow update: if inTenant(resource.data.tenantId) && roleIs(['owner','admin','staff']) && sameTenant();
      allow delete: if false;
    }

    match /productUsageCounters/{tenantId} {
      allow get: if inTenant(tenantId);
      allow list: if false;
      allow create: if inTenant(tenantId) && roleIs(['owner','admin','staff'])
        && request.resource.data.tenantId == tenantId
        && request.resource.data.productsCount is int
        && request.resource.data.productsCount >= 1;
      allow update: if inTenant(tenantId) && roleIs(['owner','admin','staff'])
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.productsCount is int
        && request.resource.data.productsCount == resource.data.productsCount + 1
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['productsCount','updatedAt']);
      allow delete: if false;
    }

    match /brands/{brandId} {
      allow read: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId) && roleIs(['owner','admin','staff']);
      allow update: if inTenant(resource.data.tenantId) && roleIs(['owner','admin','staff']) && sameTenant();
      allow delete: if inTenant(resource.data.tenantId) && roleIs(['owner','admin']);
    }

    match /customers/{customerId} {
      allow read: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId) && roleIs(['owner','admin','staff']);
      allow update: if inTenant(resource.data.tenantId) && roleIs(['owner','admin','staff']) && sameTenant();
      allow delete: if inTenant(resource.data.tenantId) && roleIs(['owner','admin']);
    }

    match /invoices/{invoiceId} {
      // saveInvoice performs an idempotency get before creating a deterministic
      // tenant-prefixed invoice document. For a new document resource.data does
      // not exist, so authorize that single-document get from the caller's own
      // tenant prefix. Existing invoice reads remain tenant-data protected.
      allow get: if (
        hasUser()
        && invoiceId.matches('^' + userData().tenantId + '_.*')
      ) || inTenant(resource.data.tenantId);
      allow list: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId) && roleIs(['owner','admin','staff']) && validInvoice();
      allow update: if inTenant(resource.data.tenantId) && sameTenant() && resource.data.status != 'cancelled'
        && (
          (roleIs(['owner','admin'])
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status','cancelledAt','cancelledBy','cancellationReason','updatedAt']))
          ||
          (roleIs(['owner','admin','staff'])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['amountReceived','outstandingAmount','paymentStatus','updatedAt'])
            && request.resource.data.amountReceived is number
            && request.resource.data.outstandingAmount is number
            && request.resource.data.amountReceived >= resource.data.amountReceived
            && request.resource.data.outstandingAmount >= 0
            && request.resource.data.amountReceived + request.resource.data.outstandingAmount == resource.data.grandTotal
            && request.resource.data.paymentStatus in ['paid','partial'])
          ||
          (roleIs(['owner','admin','staff'])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['returnedAmount','returnCount','outstandingAmount','paymentStatus','updatedAt'])
            && request.resource.data.returnedAmount is number
            && request.resource.data.returnedAmount >= 0
            && request.resource.data.returnedAmount <= resource.data.grandTotal
            && request.resource.data.returnCount is int
            && request.resource.data.returnCount > 0
            && request.resource.data.outstandingAmount is number
            && request.resource.data.outstandingAmount >= 0
            && request.resource.data.outstandingAmount <= resource.data.outstandingAmount)
        );
      allow delete: if false;
    }

    match /estimates/{estimateId} {
      allow get: if hasTenantPrefixedId(estimateId) || inTenant(resource.data.tenantId);
      allow list: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId)
        && roleIs(['owner','admin','staff']) && validEstimate();
      allow update: if inTenant(resource.data.tenantId) && sameTenant()
        && roleIs(['owner','admin','staff']) && validEstimate()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','convertedInvoiceId','updatedAt']);
      allow delete: if false;
    }

    match /counters/{counterId} {
      // Transactions must read a counter before its first create. Restrict that
      // missing-document read to the signed-in user's own deterministic IDs.
      allow get: if isOwnCounter(counterId) || inTenant(resource.data.tenantId);
      allow list: if inTenant(resource.data.tenantId);
      allow create: if isOwnCounter(counterId)
        && validTenantCreate(request.resource.data.tenantId)
        && roleIs(['owner','admin','staff'])
        && (
          (counterId == 'invoices_' + userData().tenantId
            && request.resource.data.count is int
            && request.resource.data.count >= 1
            && request.resource.data.financialYear is string)
          ||
          (counterId == 'estimates_' + userData().tenantId
            && request.resource.data.count is int
            && request.resource.data.count >= 1
            && request.resource.data.financialYear is string)
          ||
          (counterId == userData().tenantId + '_purchase'
            && request.resource.data.value is int
            && request.resource.data.value >= 1)
        );
      // Older counters may not contain tenantId. Their deterministic document
      // ID still proves ownership; the next valid write backfills tenantId.
      allow update: if isOwnCounter(counterId)
        && roleIs(['owner','admin','staff'])
        && request.resource.data.tenantId == userData().tenantId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['count','year','financialYear','value','tenantId'])
        && (
          (counterId == 'invoices_' + userData().tenantId
            && request.resource.data.count is int
            && request.resource.data.count >= 1
            && request.resource.data.financialYear is string)
          ||
          (counterId == 'estimates_' + userData().tenantId
            && request.resource.data.count is int
            && request.resource.data.count >= 1
            && request.resource.data.financialYear is string)
          ||
          (counterId == userData().tenantId + '_purchase'
            && request.resource.data.value is int
            && request.resource.data.value >= 1)
        );
      allow delete: if false;
    }

    match /suppliers/{supplierId} {
      allow read: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId) && roleIs(['owner','admin','staff']);
      allow update: if inTenant(resource.data.tenantId) && roleIs(['owner','admin','staff']) && sameTenant();
      allow delete: if inTenant(resource.data.tenantId) && roleIs(['owner','admin']);
    }

    match /purchases/{purchaseId} {
      allow read: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId) && roleIs(['owner','admin','staff']);
      allow update: if inTenant(resource.data.tenantId) && sameTenant() && resource.data.status != 'cancelled'
        && (
          (roleIs(['owner','admin'])
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancellationReason']))
          ||
          (roleIs(['owner','admin','staff'])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['paidAmount','payableAmount','paymentStatus'])
            && request.resource.data.paidAmount is number
            && request.resource.data.payableAmount is number
            && request.resource.data.paidAmount >= resource.data.paidAmount
            && request.resource.data.payableAmount >= 0
            && request.resource.data.paidAmount + request.resource.data.payableAmount
              == resource.data.totalAmount - (resource.data.returnAmount is number ? resource.data.returnAmount : 0)
            && request.resource.data.paymentStatus in ['paid','partial'])
          ||
          (roleIs(['owner','admin','staff'])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['returnAmount','returnCount','payableAmount','paymentStatus'])
            && request.resource.data.returnAmount is number
            && request.resource.data.returnAmount > (resource.data.returnAmount is number ? resource.data.returnAmount : 0)
            && request.resource.data.returnAmount <= resource.data.totalAmount
            && request.resource.data.returnCount is int
            && request.resource.data.returnCount > (resource.data.returnCount is int ? resource.data.returnCount : 0)
            && request.resource.data.payableAmount is number
            && request.resource.data.payableAmount >= 0
            && request.resource.data.payableAmount <= resource.data.payableAmount)
        );
      allow delete: if false;
    }

    match /purchaseItems/{itemId} {
      allow read: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId) && roleIs(['owner','admin','staff']);
      allow update: if false;
      allow delete: if false;
    }

    match /purchaseKeys/{keyId} {
      allow get: if hasTenantPrefixedId(keyId) || inTenant(resource.data.tenantId);
      allow list: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId)
        && roleIs(['owner','admin','staff'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId) && roleIs(['owner','admin','staff']);
      allow update, delete: if false;
    }

    match /stockAdjustments/{adjustmentId} {
      allow get: if hasTenantPrefixedId(adjustmentId) || inTenant(resource.data.tenantId);
      allow list: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId)
        && roleIs(['owner','admin'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'posted'
        && request.resource.data.reason in [
          'physical_increase','physical_decrease','damage','breakage',
          'expired','lost','found','correction','other'
        ]
        && request.resource.data.reasonNote is string
        && request.resource.data.reasonNote.size() > 0
        && request.resource.data.previousBatchQuantity is int
        && request.resource.data.previousBatchQuantity >= 0
        && request.resource.data.newBatchQuantity is int
        && request.resource.data.newBatchQuantity >= 0
        && request.resource.data.quantityDifference is int
        && request.resource.data.quantityDifference
          == request.resource.data.newBatchQuantity - request.resource.data.previousBatchQuantity
        && request.resource.data.previousProductStock is int
        && request.resource.data.newProductStock is int
        && request.resource.data.newProductStock >= 0;
      allow update, delete: if false;
    }

    match /receipts/{receiptId} {
      allow get: if hasTenantPrefixedId(receiptId) || inTenant(resource.data.tenantId);
      allow list: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId)
        && roleIs(['owner','admin','staff'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow update, delete: if false;
    }

    match /supplierPayments/{paymentId} {
      allow get: if hasTenantPrefixedId(paymentId) || inTenant(resource.data.tenantId);
      allow list: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId)
        && roleIs(['owner','admin','staff'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow update, delete: if false;
    }

    match /ledgerEntries/{entryId} {
      allow read: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId)
        && roleIs(['owner','admin','staff'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /saleReturns/{returnId} {
      allow get: if hasTenantPrefixedId(returnId) || inTenant(resource.data.tenantId);
      allow list: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId)
        && roleIs(['owner','admin','staff'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'posted'
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount > 0;
      allow update, delete: if false;
    }

    match /saleReturnSummaries/{invoiceId} {
      allow get: if ownsInvoice(invoiceId) || inTenant(resource.data.tenantId);
      allow list: if inTenant(resource.data.tenantId);
      allow create, update: if validTenantCreate(request.resource.data.tenantId)
        && roleIs(['owner','admin','staff'])
        && request.resource.data.invoiceId == invoiceId;
      allow delete: if false;
    }

    match /purchaseReturns/{returnId} {
      allow get: if hasTenantPrefixedId(returnId) || inTenant(resource.data.tenantId);
      allow list: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId)
        && roleIs(['owner','admin','staff'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'posted'
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount > 0;
      allow update, delete: if false;
    }

    match /purchaseReturnSummaries/{purchaseId} {
      allow get: if ownsPurchase(purchaseId) || inTenant(resource.data.tenantId);
      allow list: if inTenant(resource.data.tenantId);
      allow create: if validTenantCreate(request.resource.data.tenantId)
        && roleIs(['owner','admin','staff'])
        && request.resource.data.purchaseId == purchaseId;
      allow update: if inTenant(resource.data.tenantId)
        && sameTenant()
        && roleIs(['owner','admin','staff'])
        && request.resource.data.purchaseId == purchaseId;
      allow delete: if false;
    }

    match /settings/{tenantId} {
      allow read: if inTenant(tenantId);
      allow create, update: if inTenant(tenantId) && roleIs(['owner','admin']);
      allow delete: if false;
    }
  }
}
