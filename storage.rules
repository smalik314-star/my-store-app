rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userRecord() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToTenant(tenantId) {
      return signedIn()
        && userRecord().status == 'active'
        && userRecord().tenantId == tenantId;
    }

    function validImageUpload() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /tenants/{tenantId}/logos/{fileName} {
      allow read: if belongsToTenant(tenantId);
      allow create, update: if belongsToTenant(tenantId) && validImageUpload();
      allow delete: if belongsToTenant(tenantId);
    }

    match /tenants/{tenantId}/products/{fileName} {
      allow read: if belongsToTenant(tenantId);
      allow create, update: if belongsToTenant(tenantId) && validImageUpload();
      allow delete: if belongsToTenant(tenantId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
